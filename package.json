{
  "name": "zerogrunt-saran-info",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <26"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview",
    "test": "node --test tests/lab/*.test.mjs tests/model/*.test.mjs",
    "lab:record": "node lab/record.mjs",
    "evaluate": "node lab/evaluate.mjs",
    "model:record": "node scripts/record-model.mjs",
    "test:e2e": "playwright test",
    "qa": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
